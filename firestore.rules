rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    // ── Users Collection ──
    match /users/{userId} {
  allow read, write: if request.auth != null;
}
// ── Admins Collection ──
match /admins/{adminId} {
  allow read: if request.auth != null;
  allow create, update, delete: if isAdmin();
}

     // ── Participants ──
    match /participants/{participantId} {
      allow read, write: if request.auth != null
        && request.auth.uid == participantId;
    }


    // ── Audit Logs — APPEND ONLY (Immutable) ──
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // NO user can modify or delete logs
    }

    // ── Events ──
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── Event Registrations ──
    match /event_registrations/{regId} {
      allow read: if request.auth != null;
      // Admins can do anything; participants can create/cancel only their own registration
      allow create: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.participantEmail == request.auth.token.email);
      allow delete: if isAdmin() ||
        (request.auth != null &&
         resource.data.participantEmail == request.auth.token.email);
      allow update: if isAdmin(); // Admins can update checkedIn for check-in feature
    }

    // ── Registrations ──
    match /registrations/{regId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);

      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // ── Articles (CMS) ──
    match /articles/{articleId} {
      allow read: if true;       // Public content
      allow create, update, delete: if isAdmin();
    }

    // ── Team Profiles (CMS) ──
    match /team_profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Organization Info (CMS) ──
    match /org_info/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


// ── Appointments ──
match /appointments/{appointmentId} {

  allow read: if request.auth != null;

  allow create: if request.auth != null
    && request.resource.data.participantId == request.auth.uid;

  allow update: if request.auth != null
    && resource.data.participantId == request.auth.uid;

  allow delete: if isAdmin();
}

    // ── Appointment Settings ──
    match /appt_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Calendar Notes ──
match /calendar_notes/{noteId} {
  allow read: if isAdmin()
    || (request.auth != null && resource.data.userId == request.auth.uid);

  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid;

  allow update, delete: if request.auth != null
    && resource.data.userId == request.auth.uid;
}
// ── Therapists ──
match /therapists/{therapistId} {
  allow read: if request.auth != null;
  allow create, update, delete: if isAdmin();
}
//Suggestions workshop
match /workshop_suggestions/{suggestionId} {
  allow create: if request.auth != null;
  allow read, update, delete: if isAdmin();
}

// ── Summary stats documents ──
// public_summary is readable by anyone (homepage counts).
// admin_summary is admin-only. Writes are admin-only for both.
match /stats/{docId} {
  allow read: if docId == 'public_summary' || isAdmin();
  allow write: if isAdmin();
}

  }
}
